# Copy to .env (never commit .env). See README, "Remote MCP server".

# Public origin of the server (the tunnel's hostname). OAuth and every link use it.
ARCHITECTURER_PUBLIC_URL=https://arch.example.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → token)
CLOUDFLARE_TUNNEL_TOKEN=

# Login for the consent / admin / viewer pages: Cloudflare Access (recommended) ...
#   team domain: Zero Trust → Settings → Custom pages → team domain (myteam.cloudflareaccess.com)
#   AUD: the Access application's "Application Audience (AUD) Tag"
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Who may approve apps (comma-separated). Empty = whoever the Access policy lets in.
ARCHITECTURER_ALLOWED_EMAILS=
# ... and/or a password (long and random; used if Access is not configured or as a fallback)
ARCHITECTURER_ADMIN_PASSWORD=

# Host folder for /data (plans, state, asset cache). Unraid: /mnt/cache/appdata/architecturer
ARCHITECTURER_DATA=./data
# Render/export workers. Each needs up to ~3.5 GB for big furnished plans; raise ARCHITECTURER_MEMORY with it.
ARCHITECTURER_WORKERS=1
ARCHITECTURER_MEMORY=4g
ARCHITECTURER_CPUS=2

# Let plans fetch models / textures from private network addresses (a NAS on the LAN). Off by default.
# ARCHITECTURER_ALLOW_PRIVATE_FETCH=1
