# Copy to .env (never commit .env). See docs/REMOTE_MCP.md.
# Accounts are not configured here: on first start, open <public URL>/setup with the setup code from the
# container log (or: docker compose exec -it architecturer node bin/arch.js user add --name <you>).

# Public origin of the server (the tunnel's hostname). OAuth and every link use it.
ARCHITECTURER_PUBLIC_URL=https://arch.example.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → token). Only the tunnel:
# no Cloudflare Access needed.
CLOUDFLARE_TUNNEL_TOKEN=

# Host folder for /data (plans, state, asset cache). Unraid: /mnt/user/appdata/architecturer
ARCHITECTURER_DATA=./data
# Render/export workers. Each needs up to ~3.5 GB for big furnished plans; raise ARCHITECTURER_MEMORY with it.
ARCHITECTURER_WORKERS=1
ARCHITECTURER_MEMORY=4g
ARCHITECTURER_CPUS=2

# Let plans fetch models / textures from private network addresses (a NAS on the LAN). Off by default.
# ARCHITECTURER_ALLOW_PRIVATE_FETCH=1
