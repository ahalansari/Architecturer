    "@resvg/resvg-js": "^2.6.2",
    "draco3dgltf": "^1.5.7",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "mikktspace": "^1.1.1",
    "pngjs": "^7.0.0",
