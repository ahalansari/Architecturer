{
  "name": "architecturer",
  "version": "0.8.1",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "arch": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "tsx --test test/*.test.ts",
    "prepare": "tsc -p .",
    "mcp:http": "tsx src/mcp/http.ts"
  },
  "license": "MIT",
  "description": "AI-first 3D architecture modeler: JSON building plans -> textured game-ready GLB",
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.6",
    "docx": "^9.8.1",
    "draco3dgltf": "^1.5.7",
    "earcut": "^3.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "mikktspace": "^1.1.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/earcut": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "ktx-parse": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "arch": "./bin/arch.js",
    "architecturer-mcp": "./bin/mcp.js",
    "architecturer-mcp-http": "./bin/mcp-http.js"
  },
  "files": [
    "dist",
    "bin",
    "viewer",
    "README.md"
  ],
  "optionalDependencies": {
    "webgpu": "^0.6.2"
  }
}
